# Public names only (docs/environments.md). Values live in Netlify env.
NEXT_PUBLIC_SITE_URL=https://tapnconnect.ae
# Sub-path when the site is served under one (GitHub Pages: /tnc-website); empty on a domain
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_APP_URL=https://profile.tapnconnect.ae
NEXT_PUBLIC_PORTAL_URL=https://admin.tapnconnect.ae
NEXT_PUBLIC_BACKEND_URL=https://service.tapnconnect.ae
# Google Tag Manager container (Consent Mode v2; analytics is off until the visitor says yes)
NEXT_PUBLIC_GTM_ID=
# Cloudflare Turnstile site key for the Order page (secret stays on the server that receives the order)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Backend routes the Order page calls (E47 O7 sales agent; the public order submit). Defaults shown.
NEXT_PUBLIC_SALES_PATH=/api/public/sales
NEXT_PUBLIC_ORDER_PATH=/api/public/order
