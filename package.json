{
  "name": "tnc-website",
  "version": "0.1.0",
  "private": true,
  "description": "TapNConnect product website — the story, how it works, pricing and ordering at tapnconnect.ae",
  "scripts": {
    "dev": "next dev -p 4410",
    "prebuild": "node --no-warnings scripts/llms.mjs",
    "build": "next build",
    "postbuild": "node --no-warnings scripts/postbuild.mjs",
    "start": "npx serve out -l 4410",
    "lint": "next lint",
    "test": "node --test src/lib/*.test.mjs scripts/*.test.mjs",
    "og": "node --no-warnings scripts/og.mjs",
    "check": "node --no-warnings scripts/check.mjs",
    "flow": "node --no-warnings scripts/flow.mjs",
    "acts": "node --no-warnings scripts/acts.mjs",
    "media": "node --no-warnings scripts/media.mjs",
    "stills": "node --no-warnings scripts/stills.mjs",
    "vitals": "node --no-warnings scripts/vitals.mjs"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "geist": "1.8.2",
    "lucide-react": "1.61.0",
    "next": "14.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "autoprefixer": "10.6.1",
    "eslint": "8.57.1",
    "eslint-config-next": "14.1.3",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19"
  }
}
